DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE_NAME
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional local SQLite demo seeding only. Use unique emails and passwords.
# Demo passwords must be at least 12 characters and differ from each other.
# Use a valid public college domain such as @smartgate.edu; reserved names like .local are rejected by EmailStr.
# SMARTGATE_DEMO_ADMIN_EMAIL=admin@smartgate.edu
# SMARTGATE_DEMO_ADMIN_PASSWORD=
# SMARTGATE_DEMO_HOD_EMAIL=hod@smartgate.edu
# SMARTGATE_DEMO_HOD_PASSWORD=
# SMARTGATE_DEMO_ADVISOR_EMAIL=advisor@smartgate.edu
# SMARTGATE_DEMO_ADVISOR_PASSWORD=
# SMARTGATE_DEMO_STUDENT_EMAIL=student@smartgate.edu
# SMARTGATE_DEMO_STUDENT_PASSWORD=
# SMARTGATE_DEMO_SECURITY_EMAIL=security@smartgate.edu
# SMARTGATE_DEMO_SECURITY_PASSWORD=
